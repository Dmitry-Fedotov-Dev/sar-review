{
  "uid": "sar-health",
  "title": "SAR Review — состояние платформы",
  "tags": [
    "sar"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Онлайн сейчас",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sar_viewers_online",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "нет данных"
        },
        "overrides": []
      },
      "description": "Сколько человек прямо сейчас открыли платформу. Считается по heartbeat раз в 15 с: «онлайн» -- уникальные имена с отметкой не старше 40 с."
    },
    {
      "type": "stat",
      "title": "Платформа",
      "description": "Отвечает ли сервер. Пропадание значения = сервер недоступен или Prometheus до него не дотягивается.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sar_up",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "работает",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "НЕДОСТУПНА",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "НЕДОСТУПНА"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Воркер",
      "description": "Секунд с последней отметки. Воркер умеет умирать тихо: очередь при мёртвом воркере выглядит так же, как при живом без работы.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sar_worker_heartbeat_age_seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "не отмечался",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 180
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Свободно на диске",
      "description": "Уже приводило к остановке: за сутки место уползло с 18 ГБ до 3.4, потому что отчёты хранили все полные кадры.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sar_disk_free_bytes",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3000000000
              },
              {
                "color": "green",
                "value": 10000000000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Копия базы, давность",
      "description": "Возраст самой свежей резервной копии БАЗЫ ДАННЫХ: отчёты, триаж, ручные пометки, покрытие просмотра, участники и права. Исходное видео и готовые отчёты в копию НЕ входят — они большие и пересчитываются из исходников. Если копий нет ни одной, метрика отсутствует и панель показывает «копий нет»: подменять её нулём нельзя, time() - 0 нарисовал бы полвека.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sar_backup_age_seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "копий нет",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 172800
              },
              {
                "color": "red",
                "value": 604800
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Залипло в обработке",
      "description": "Отчёты в статусе processing дольше трёх часов: на диске всё готово, а статус остался. Известная болезнь, чинится перезапуском воркера.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sar_stuck_reports",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Процессор",
      "description": "Занято ядер против общего числа. Потолок показан линией: без него проценты не читаются -- 80% на двух ядрах и на двадцати означают разное. Детектор намеренно оставляет два ядра веб-слою, поэтому упор в потолок ожидаем при обработке видео.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sar_cpu_percent * sar_cpu_cores / 100",
          "legendFormat": "занято ядер",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        },
        {
          "expr": "sar_cpu_cores",
          "legendFormat": "всего ядер",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "custom": {
            "fillOpacity": 20,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "всего ядер"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "занято ядер"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Оперативная память",
      "description": "Занято против установленного объёма. Пунктир -- потолок. Инференс держит модель в памяти, поэтому рост при обработке видео нормален; тревожен рост, который не спадает после её окончания.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sar_memory_used_bytes",
          "legendFormat": "занято",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        },
        {
          "expr": "sar_memory_total_bytes",
          "legendFormat": "всего",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
