    {
      "type": "stat",
      "title": "Запросов в секунду",
      "description": "Суммарная нагрузка на API за последние 5 минут. Счётчики живут в памяти сервера, поэтому его перезапуск обнуляет их -- историю хранит Prometheus.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(sar_http_requests_total[5m]))",
          "legendFormat": "Запросов в секунду",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Доля ошибок",
      "description": "Ответы 5xx, кроме проверки здоровья: она отвечает 503, когда что-то не так, и это её штатный сигнал, а не поломка сервера. Ноль ошибок показывается как 0%, а не как пустая панель -- пусто здесь означало бы «нет данных», и это разные новости.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(sar_http_requests_total{status=~\"5..\",endpoint!=\"healthz\"}[5m])) or 0 * sum(rate(sar_http_requests_total{endpoint!=\"healthz\"}[5m]))) / clamp_min(sum(rate(sar_http_requests_total{endpoint!=\"healthz\"}[5m])), 0.0001)",
          "legendFormat": "Доля ошибок",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Ответ, 95-й процентиль",
      "description": "95 запросов из 100 укладываются в это время. Среднее здесь врёт: его вытягивают вниз тысячи мгновенных отдач картинок.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sar_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "Ответ, 95-й процентиль",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Сервер не перезапускался",
      "description": "Сколько сервер работает без перезапуска. Обнуление счётчиков запросов на графиках объясняется именно этим.",
      "gridPos": {
