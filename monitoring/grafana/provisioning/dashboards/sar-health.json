    {
      "type": "timeseries",
      "title": "Время ответа",
      "description": "Три черты снизу вверх: половина запросов, 95 из 100 и 99 из 100. Расхождение между ними и есть «иногда подтормаживает».",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sar-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sar_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "половина запросов",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sar_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "95 из 100",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sar_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "99 из 100",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "sar-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 2,
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
