# Env-файл проекта SAR Review на сервере cd.
# Положить: /etc/cdd/env/<проект>.env, права 600, владелец root.
#   sudo install -m 600 /dev/null /etc/cdd/env/sar.env && sudo nano /etc/cdd/env/sar.env
# В репозиторий НЕ коммитится -- тут пароль и токен бота.
#
# Формат docker --env-file: КЛЮЧ=значение, без кавычек (кавычки станут
# частью значения), без пробелов вокруг "=".

# ОБЯЗАТЕЛЬНО при первом старте. Без него (или с change_me) контейнер не
# стартует. Дальше пароль хранится в data/sar_config.json; если он задан
# здесь, то при каждом старте перекрывает значение из файла.
SAR_SHARED_PASSWORD=

# Телеграм-бот. Пусто -- бот не запускается.
# У КАЖДОГО экземпляра свой бот: два процесса на одном токене Telegram не
# пускает (getUpdates conflict), и один из ботов будет падать.
SAR_TELEGRAM_BOT_TOKEN=
# chat_id координаторов через запятую
SAR_TELEGRAM_ADMIN_CHAT_IDS=
# Адрес именно ЭТОГО экземпляра -- его бот вставляет в ссылки входа.
# SAR_SERVICE_URL=https://sar.example.com
SAR_GUIDE_URL=

# Ставить ли новые файлы в очередь детектору. Модели в образе нет, поэтому
# по умолчанию false. Переносится в базу ОДИН раз при первом старте, дальше
# меняется в админке.
# SAR_AUTO_PROCESS=false

# Резервные копии базы: как часто (часы, 0 -- выключить) и сколько хранить.
# SAR_BACKUP_INTERVAL_HOURS=6
# SAR_BACKUP_KEEP=10

# Остальное из sar_config.example.json -- одной строкой JSON, поверх файла:
# SAR_CONFIG_OVERRIDES={"server":{"proxy_threads":2},"conf":0.2}
