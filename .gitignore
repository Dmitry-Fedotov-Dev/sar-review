# ---------------------------------------------------------------------------
# СЕКРЕТЫ И РЕАЛЬНЫЕ ДАННЫЕ ОПЕРАЦИИ — НИКОГДА не коммитить
# ---------------------------------------------------------------------------

# Боевой конфиг: общий пароль сервиса, токен Telegram-бота, chat_id
# координаторов, публичные URL. В репозитории только sar_config.example.json.
# (См. CLAUDE.md: этот файл уже однажды утекал в архив обновлений и затирал
# пароль пользователя обратно на дефолтный.)
sar_config.json
# Копии того же файла со всем содержимым: .bak после правки, .old, .save.
# Реальный случай: скрипт обновления ссылок оставил sar_config.json.bak с
# паролем и токеном прямо в папке проекта, и он НЕ попадал под строку выше --
# один "git add -A" отправил бы секреты в публичный репозиторий.
sar_config.json.*

# Резервные копии конфига, которые делает sar_tunnel.py при смене адреса
# туннеля. Имя не подходило ни под одно правило выше, и файл с паролем и
# токеном бота спокойно попадал в git status как готовый к коммиту.
sar_config.backup_*.json

# Всё служебное: SQLite с ИМЕНАМИ УЧАСТНИКОВ и их telegram-никами, ручные
# наблюдения, готовые отчёты с реальными кадрами поисковой операции,
# Flask secret.key, логи процессов, превью.
sar_data/

# SRT-телеметрия реальных вылетов — GPS-треки операции.
# Папки telemetry/ было мало: дрон кладёт .SRT рядом с видео, внутри
# папки операции, и файлы с GPS-треком реального поиска оставались
# видимыми для коммита.
telemetry/
*.SRT
*.srt

# Экспортированный датасет — кадры реальной операции + разметка
sar_dataset/

# Исходное видео/фото с дрона, которые кладут в корень watch_dir
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv
*.ts
*.m4v
*.wmv
*.jpg
*.JPG
*.jpeg
*.png
*.tiff
*.bmp
*.webp

# ---------------------------------------------------------------------------
# ВЕСА МОДЕЛЕЙ — большие бинарники, качаются отдельно
# ---------------------------------------------------------------------------
*.pt
*.onnx
*.engine
weights/

# ---------------------------------------------------------------------------
# Служебное окружение
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Локальные настройки Claude Code (содержат абсолютные пути машины)
.claude/settings.local.json

# Логи вспомогательных процессов
*.log
cf_out.log
cf_err.log

# ОС
Thumbs.db
desktop.ini
.DS_Store

# Пароль Grafana -- как и sar_config.json, в репозиторий не попадает
monitoring/.env

# Резервные копии базы: те же персональные данные, что и в самой БД.
sar_backups/

# Архивы с материалом операции.
*.zip

# Служебная метка папки операции.
.sar_operation

# Рабочие каталоги инструментов и документы, попавшие в корень по ошибке.
.claude/
/*.rtf
/*.docx

# Временные папки тестов (см. pytest.ini): настоящие файлы по десяткам
# мегабайт, переживать прогон им незачем.
.pytest_tmp/
