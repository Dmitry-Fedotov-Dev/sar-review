# Обратный прокси перед платформой: HTTPS и постоянное имя.
#
# Запускать НЕ напрямую, а через sar_https.py -- он подставит имя из
# sar_config.json. Имя, записанное здесь вторым местом, рано или поздно
# разойдётся с тем, что в конфиге: в этом проекте так уже было с путём к
# папке резервных копий, который считался в трёх местах и в двух неверно.
#
#   python sar_https.py            запустить
#   python sar_https.py check      проверить конфиг, ничего не поднимая
#   python sar_https.py local      проверить схему без домена, на localhost
#
# Порты 80 и 443 должны быть проброшены на эту машину. 80 нужен не для
# работы, а для выпуска сертификата: Let's Encrypt проверяет им, что имя
# действительно ваше.

# Глобального блока с почтой здесь НЕТ намеренно. Caddy не принимает
# пустое значение email и отказывается разбирать весь конфиг целиком --
# то есть незаполненное необязательное поле роняло бы запуск. Продление
# сертификата идёт само, почта нужна была бы только для предупреждений.

{$SAR_DOMAIN} {
	# Сжимать ТОЛЬКО то, что от этого выигрывает. Видео и картинки уже
	# сжаты: прогоняя их через gzip, мы потратим процессор и не выиграем
	# ничего -- а процессор тут же нужен ffmpeg для лёгких копий.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy 127.0.0.1:8080 {
		# Отдавать байты сразу, не копя в буфере. Нужно для живого
		# предпросмотра рамок во время обработки: он опрашивает сервер, и
		# буферизация превратила бы это в рывки.
		flush_interval -1

		# Видео отдаётся кусками по запросу браузера (Range), и файл может
		# качаться долго. Ответ не должен обрываться по таймауту на
		# середине -- оборванное видео выглядит как целое, просто короче.
		transport http {
			response_header_timeout 5m
		}
	}

	log {
		output file sar_data/https/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Grafana. Раскомментируйте, если нужен доступ к мониторингу снаружи, и
# заведите второе имя в deSEC.
#
# {$SAR_GRAFANA_DOMAIN} {
# 	reverse_proxy 127.0.0.1:3000
# }
